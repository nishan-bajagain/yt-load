# ============================================================
# YT-LOAD — Environment Variables
# Copy this file to .env.local for local development overrides
# ============================================================

# ----------------------------------------------------------
# YOUTUBE_COOKIE  (optional; not required for public videos)
# ----------------------------------------------------------
# If you deploy on Vercel, Railway, Render, AWS, or any
# datacenter IP, YouTube may block some unauthenticated requests.
# YT-LOAD tries cookie-free clients first. This value is only used as
# a last resort for restricted videos.
#
# How to get it:
#   1. Open youtube.com in Chrome, sign in
#   2. Open DevTools → Application → Cookies → youtube.com
#   3. Copy the full Cookie header value (all key=value pairs)
#   4. Paste the full string below (keep the quotes)
#
# YOUTUBE_COOKIE="VISITOR_INFO1_LIVE=xxx; YSC=xxx; __Secure-3PSID=xxx; ..."

# ----------------------------------------------------------
# YOUTUBE_PROXY  (optional — for residential IP routing)
# ----------------------------------------------------------
# If your hosting IP is blocked and you have a residential
# proxy or SOCKS5 proxy available:
#
# YOUTUBE_PROXY=http://user:pass@proxy.host:3128
# YOUTUBE_PROXY=socks5://user:pass@proxy.host:1080
# Public canonical URL used for metadata and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://yt-load.vercel.app
